{
	"name": "ci-workflows",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"description": "Tooling for validating this repository's own CI contracts. Not published; the published artifact is the workflows and composite actions under .github/.",
	"engines": {
		"node": ">=26"
	},
	"scripts": {
		"contract": "node scripts/contract-check.ts",
		"lint": "node scripts/lint-workflows.mjs",
		"release": "node scripts/release.ts",
		"test": "node --test \"scripts/**/*.test.ts\"",
		"typecheck": "tsc --noEmit"
	},
	"dependencies": {
		"minimatch": "^11.0.5",
		"semver": "^7.8.6"
	},
	"devDependencies": {
		"@types/node": "^26.6.6",
		"@types/semver": "^7.8.0",
		"typescript": "^7.0.2",
		"yaml": "2.9.1"
	}
}
